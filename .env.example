# Supabase Dashboard > Connect > Transaction pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase project URL and browser-safe publishable key used by server-side Auth requests.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Reserved for privileged server-side Supabase operations/private storage. Never expose this key in browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret

# Keep false while configuring/testing Google sign-in. Set true only after email/password and Google auth are verified.
AUTH_REQUIRED=false

# Optional dedicated user-session signing secret. If omitted, it is safely derived from ADMIN_PASSWORD.
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters

# Cloud Run Secret Manager. Use at least 16 random characters; never commit the real value.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Displayed in the privacy notice. Use a monitored address before public launch.
PRIVACY_CONTACT_EMAIL=operator@example.com

# Lidl 기능을 다시 운영할 때만 빌드 환경에서 true로 설정합니다. 기본값은 비활성화입니다.
NEXT_PUBLIC_LIDL_ENABLED=false
