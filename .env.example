# Supabase Dashboard > Connect > Transaction pooler
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Server-side Supabase Auth verification and private storage. Never expose the service role key in browser code.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-secret

# Keep false while configuring/testing Google and Apple providers. Set true only after sign-in is verified in production.
AUTH_REQUIRED=false

# Cloud Run Secret Manager. Use at least 16 random characters; never commit the real value.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional overrides. If omitted, both values are safely derived from ADMIN_PASSWORD.
APP_ACCESS_CODE=replace-with-a-private-invite-code
APP_SESSION_SECRET=replace-with-at-least-32-random-characters

# Displayed in the privacy notice. Use a monitored address before public launch.
PRIVACY_CONTACT_EMAIL=operator@example.com

# Lidl 기능을 다시 운영할 때만 빌드 환경에서 true로 설정합니다. 기본값은 비활성화입니다.
NEXT_PUBLIC_LIDL_ENABLED=false
